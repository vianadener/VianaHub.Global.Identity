  <ItemGroup>
    <ProjectReference Include="..\VianaHub.Global.Identity.Application\VianaHub.Global.Identity.Application.csproj" />
    <ProjectReference Include="..\VianaHub.Global.Identity.Infra.IoC\VianaHub.Global.Identity.Infra.IoC.csproj" />
